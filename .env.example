# ============================================
# CONFIGURACIÓN DEL SECRETARIO IA V3
# ============================================
# Copia este archivo como .env y rellena los valores.
# NUNCA subas tu archivo .env a GitHub.
# ============================================

# ============================================
# OBLIGATORIO
# ============================================
# Token del bot de Telegram (obtener de @BotFather)
TELEGRAM_TOKEN=AQUI_VA_TU_TOKEN_DE_TELEGRAM

# ============================================
# OPCIONAL (dejar vacío para usar valores por defecto)
# ============================================
# Ruta del Vault de Obsidian (por defecto: ../Almacenamiento/vault)
# VAULT_PATH=../Almacenamiento/vault

# Ruta de FFmpeg (solo si usas mensajes de voz)
# FFMPEG_PATH=C:/ruta/a/ffmpeg.exe

# URL de LM Studio (por defecto: http://localhost:1234)
# LM_STUDIO_URL=http://localhost:1234/v1/chat/completions

# Modelo de LM Studio (por defecto: Qwen3-4B-2507)
# LM_STUDIO_MODEL=Qwen3-4B-2507